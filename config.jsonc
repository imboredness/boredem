{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/t.txt",
      "padding": {
      "top": 2,
      "right": 6,
      "left": 2
    },
  }
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    "break",
    {
      "type": "os",
      "key": " ",
      "format": "Arch (Btw)"
    },
    {
      "type": "host",
      "key": "🖥 ",
      "format": "Bored-PC"
    },
    {
      "type": "shell",
      "format": "fish",
      "key": ">_"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "#A7C080",
      "color": "#DBBC7F"
    },
    {
      "type": "de",
      "format": "{}",
      "key": " "
    },
    {
      "type": "cpu",
      "key": "󰍛 ",
      "format": "intel i3 1215U"
    },
    {
      "type": "gpu",
      "key": "󰢮 ",
      "format": "integrated"
    },
    {
      "type": "memory",
      "key": "🎟 ",
      "format": "{} {}"
    },
    
    {
      "type": "uptime",
      "key": " "
    },
    
    "break",
    "break",
    "break"
  ]
}
